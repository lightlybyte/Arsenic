  "authors": [
    "TheLightlybyt"
  ],
  "contact": {
    "homepage": "https://fabricmc.net/",
    "sources": "https://github.com/FabricMC/fabric-example-mod"
  },
  "license": "CC0-1.0",
  "icon": "assets/arsenic/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.lightlybyte.fabric.ArsenicFabric"
